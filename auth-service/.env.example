# Copy to .env and fill in values. Never commit .env

# MongoDB
# Local:
# MONGODB_URI=mongodb://localhost:27017/auth_db
#
# Atlas — prefer STANDARD connection string (mongodb://), NOT mongodb+srv, if you see:
#   "Failed looking up TXT record for host ...mongodb.net"
# That error means UDP DNS (TXT/SRV) is blocked on your network; srv:// always needs it.
# Atlas → Connect → Drivers → "Show advanced" / older driver → copy mongodb://... string
# Example shape (replace hosts/replicaSet from Atlas):
# MONGODB_URI=mongodb://USER:PASS@host0:27017,host1:27017,host2:27017/auth_db?ssl=true&authSource=admin&replicaSet=atlas-xxxxx-shard-0
MONGODB_URI=mongodb://localhost:27017/auth_db

# JWT (use a long random string, min 256 bits)
JWT_SECRET=your-secret-here

# Gmail OTP (optional — leave blank to print OTP in console)
# Use a Google App Password: https://myaccount.google.com/apppasswords
GMAIL_USERNAME=your@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# 465 (SSL) or 587 (STARTTLS) — use whichever Test-NetConnection shows as open
GMAIL_SMTP_PORT=465

# otp | link
VERIFICATION_STRATEGY=otp
VERIFICATION_BASE_URL=http://localhost:8081/api/auth/verify/link
